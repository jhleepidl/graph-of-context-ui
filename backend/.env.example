GOC_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/goc
GOC_DB_AUTO_CREATE=true
GOC_DB_CREATE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres
GOC_DB_CREATE_DATABASE=postgres
GOC_AUTH_REQUIRED=true
GOC_ADMIN_KEY=change-me-admin-key
GOC_UI_TOKEN_SECRET=change-me-ui-token-secret
GOC_UI_TOKEN_TTL_DEFAULT_SEC=21600
GOC_TELEGRAM_BOT_TOKEN=
GOC_TELEGRAM_ALLOWED_USER_IDS=
GOC_TELEGRAM_DEFAULT_SERVICE_ID=default
GOC_ENFORCE_CONVERSATION_OWNER=false
GOC_CORS_ALLOW_ORIGINS=*
GOC_EMBED_DIM=1536
GOC_VECTOR_BACKEND=faiss
GOC_FAISS_DIR=./data/faiss
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GOC_FOLD_SUMMARY_MODEL=gpt-5-nano
OPENAI_EMBED_MODEL=text-embedding-3-small
